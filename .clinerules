## C# Block Structure

```csharp
using org.minsol.[PluginName].ViewModels.Blocks.[BlockName];
using Rock.Attribute;
using Rock.Model;
using Rock.Obsidian.UI;
using Rock.Security;
using Rock.ViewModels.Blocks;
using Rock.Web.Cache;

namespace org.minsol.[PluginName].Blocks.[BlockName]
{
    /// <summary>
    /// [Block description. Full sentence. Period at end.]
    /// </summary>
    [DisplayName( "[Human Readable Block Name]" )]
    [Category( "MinSol > [Category]" )]
    [Description( "[Block description matching the XML doc above.]" )]
    [IconCssClass( "fa fa-[icon]" )]
    [SupportedSiteTypes( Model.SiteType.Web )]
    [Rock.SystemGuid.BlockTypeGuid( "[NEW-GUID-HERE]" )]
    public class [BlockName] : RockObsidianBlockType
    {
        #region Keys

        private static class AttributeKey
        {
            // Block attribute key constants go here
        }

        private static class PageParameterKey
        {
            // Page parameter key constants go here
        }

        private static class NavigationUrlKey
        {
            // Navigation URL key constants go here
        }

        #endregion

        #region Methods

        /// <inheritdoc/>
        public override object GetObsidianBlockInitializationValue()
        {
            var box = new [BlockName]Box
            {
                Entity = GetEntityBag(),
                Options = GetOptionsBag()
            };

            return box;
        }

        /// <summary>
        /// Gets the entity bag for block initialization.
        /// </summary>
        /// <returns>A populated <see cref="[BlockName]Bag"/>.</returns>
        private [BlockName]Bag GetEntityBag()
        {
            // Implementation
            return new [BlockName]Bag();
        }

        /// <summary>
        /// Gets the options bag containing select lists and configuration.
        /// </summary>
        /// <returns>A populated <see cref="[BlockName]OptionsBag"/>.</returns>
        private [BlockName]OptionsBag GetOptionsBag()
        {
            // Implementation
            return new [BlockName]OptionsBag();
        }

        #endregion
    }
}
```

